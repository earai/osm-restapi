#!/usr/bin/env bash
set -euo pipefail

FASTAPI_URL="http://localhost:8000"
API_SVC="osm-fastapi"
DB_SVC="osm-postgis"


ROAD_EP="$FASTAPI_URL/osm/roads/polygon"
AMENITY_EP="$FASTAPI_URL/osm/amenity/polygon"

# Bring up services
echo "🚀 Starting services..."
docker compose up -d --build

docker exec -it osm-postgis psql -U postgres -d osm -c


POLYGON_JSON='{
  "type": "Polygon",
  "coordinates": [[
    [-73.9885, 40.7585],
    [-73.9855, 40.7585],
    [-73.9855, 40.7605],
    [-73.9885, 40.7605],
    [-73.9885, 40.7585]
  ]]
}'

# Helper: count features without jq
python_json_count_features () {
  python3 - "$@" <<'PY' || true
import sys, json
try:
    data = json.load(sys.stdin)
    feats = data.get("features", [])
    print(len(feats))
except Exception:
    print(0)
PY
}

# Wait for FastAPI
wait_for_api () {
  echo "⏳ Waiting for FastAPI..."
  for i in {1..30}; do
    if curl -sf "$FASTAPI_URL/docs" > /dev/null; then
      echo "✅ FastAPI is up."
      return 0
    fi
    sleep 2
  done
  echo "❌ FastAPI failed to start."
  exit 1
}

# Wait for PostGIS
wait_for_db () {
  echo "⏳ Waiting for PostGIS..."
  for i in {1..30}; do
    if docker compose exec -T "$DB_SVC" psql -U postgres -d osm -c "SELECT 1;" >/dev/null 2>&1; then
      echo "✅ PostGIS is ready."
      return 0
    fi
    sleep 2
  done
  echo "⚠️ PostGIS check failed, skipping DB count."
  return 1
}

# Count features at endpoint
feature_count () {
  curl -s -X POST "$1" \
    -H "accept: application/json" \
    -H "Content-Type: application/json" \
    -d "$POLYGON_JSON" | python_json_count_features
}

# Check DB cache
db_counts () {
  docker compose exec -T "$DB_SVC" psql -U postgres -d osm -c \
    "SELECT query_key, COUNT(*) AS n FROM public.osm_cache GROUP BY query_key ORDER BY n DESC;"
}

wait_for_api
wait_for_db || true

# First calls
echo "🧪 First roads request (expected Overpass)..."
RC1=$(feature_count "$ROAD_EP")
echo "   Roads features: $RC1"

echo "🧪 First amenities request (expected Overpass)..."
AC1=$(feature_count "$AMENITY_EP")
echo "   Amenities features: $AC1"

# Second calls (cache check)
echo "♻️ Second roads request (cache expected)..."
RC2=$(feature_count "$ROAD_EP")
echo "   Roads features: $RC2"

echo "♻️ Second amenities request (cache expected)..."
AC2=$(feature_count "$AMENITY_EP")
echo "   Amenities features: $AC2"

# DB counts if DB is available
if docker compose ps | grep -q "$DB_SVC"; then
  echo "🗃️ Cache counts from PostGIS:"
  db_counts || true
else
  echo "⚠️ Skipping DB cache check — PostGIS not running."
fi

echo "✅ Done."
